{
  "schemaVersion": 1,
  "systemVersion": "CONTENT_PRODUCTION_V1",
  "publicationPolicyDefault": "cultivar",
  "maxConcurrentRetry": 1,
  "imageGenerationPolicy": {
    "defaultQuality": "medium",
    "highQualityRequiresExplicitHumanRequest": true,
    "requiredProductionApprovalType": "human-visual-review",
    "aiVisualQaCanApproveProduction": false,
    "unapprovedOutputDisposition": "candidate-artifact-only",
    "automaticGenerationMayPublish": false
  },
  "automaticProductionPolicy": {
    "enabled": true,
    "publicationModeDefault": "auto",
    "dataFirstPublication": true,
    "autoApprovalStatus": "auto-approved",
    "aiVisualQaApprovalType": "ai-visual-qa",
    "aiVisualQaEngine": "local-clip-semantic-v1",
    "aiVisualQaModel": "openai/clip-vit-base-patch32",
    "imageModel": "gpt-image-2",
    "quality": "medium",
    "maxImageRequestsPerCultivar": 1,
    "automaticImageRetry": 0,
    "highQualityAutoEscalation": false,
    "postPublicationHumanReject": true
  },
  "modes": ["new-publication", "image-replacement"],
  "activeRunStatuses": ["ACTIVE", "WAITING_REPAIR", "PUBLISHING"],
  "terminalRunStatuses": ["SUCCESS", "CANCELLED", "ABORTED_CONCURRENT_UPDATE", "FAILED_AUDIT"],
  "productionPhases": ["STOCKED", "DATA_READY", "IMAGE_PENDING", "IMAGE_READY", "VISUAL_LINKED", "PUBLISHED", "NEEDS_REVIEW", "ABORTED_CONCURRENT_UPDATE"],
  "stablePhases": ["STOCKED", "DATA_READY", "IMAGE_PENDING", "IMAGE_READY", "VISUAL_LINKED", "PUBLISHED"],
  "allowedPhaseTransitions": {
    "STOCKED": ["DATA_READY", "NEEDS_REVIEW", "ABORTED_CONCURRENT_UPDATE"],
    "DATA_READY": ["IMAGE_PENDING", "NEEDS_REVIEW", "ABORTED_CONCURRENT_UPDATE"],
    "IMAGE_PENDING": ["IMAGE_READY", "NEEDS_REVIEW", "ABORTED_CONCURRENT_UPDATE"],
    "IMAGE_READY": ["VISUAL_LINKED", "NEEDS_REVIEW", "ABORTED_CONCURRENT_UPDATE"],
    "VISUAL_LINKED": ["PUBLISHED", "NEEDS_REVIEW", "ABORTED_CONCURRENT_UPDATE"],
    "PUBLISHED": ["IMAGE_PENDING", "NEEDS_REVIEW"],
    "NEEDS_REVIEW": ["STOCKED", "DATA_READY", "IMAGE_PENDING", "IMAGE_READY", "VISUAL_LINKED", "ABORTED_CONCURRENT_UPDATE"],
    "ABORTED_CONCURRENT_UPDATE": []
  },
