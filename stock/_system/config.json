{
  "$schemaVersion": "AUTO_STOCK_V1",
  "version": 1,
  "enabled": true,
  "branch": "master-migration",
  "writeRoot": "stock/",
  "systemRoot": "stock/_system/",
  "itemsRoot": "stock/items/",
  "runsRoot": "stock/runs/",
  "batchSize": 3,
  "runIdentity": {
    "newRunIdPattern": "^run-[0-9]{8}T[0-9]{6}-[0-9a-f]{6}$",
    "timestampFormat": "YYYYMMDDTHHMMSS",
    "timestampZone": "UTC",
    "randomHexLength": 6,
    "batchSizeMustNotBeUsedAsRunId": true,
    "requireRemoteNonexistenceCheckBeforeWrite": true,
    "collisionAction": "regenerate",
    "maxGenerationAttempts": 20,
    "legacyRunIds": [
      "run-3"
    ]
  },
  "images": {
    "mode": "disabled-v1",
    "allowFiles": false,
    "defaultVisuals": []
  },
  "imageStock": {
    "schemaVersion": "IMAGE_STOCK_V1",
    "enabled": true,
    "branch": "master-migration",
    "imagesRoot": "stock/images/",
    "imageRunsRoot": "stock/image-runs/",
    "batchSize": 3,
    "allowedFormats": [
      "webp"
    ],
    "primaryFilename": "primary.webp",
    "sourceType": "aiGenerated",
    "runIdentity": {
      "newRunIdPattern": "^image-run-[0-9]{8}T[0-9]{6}-[0-9a-f]{6}$",
      "timestampFormat": "YYYYMMDDTHHMMSS",
      "timestampZone": "UTC",
      "randomHexLength": 6,
      "batchSizeMustNotBeUsedAsRunId": true,
      "requireRemoteNonexistenceCheckBeforeWrite": true,
      "collisionAction": "regenerate",
      "maxGenerationAttempts": 20
    },
    "visualPolicy": {
      "role": "primary",
      "aiGenerated": true,
      "requireExactTopLevelAndCandidateMatch": true,
      "requireEvidencePass": true,
      "requirePreparationMetadataMatch": true
    },
    "transaction": {
      "oneRunOneCommit": true,
      "oneRunOneRefUpdate": true,
      "forceRefUpdate": false,
      "allowBranchCreation": false,
      "method": [
        "blob",
        "tree",
        "commit",
        "ref-update"
      ]
    },
    "concurrency": {
      "requireBaseShaMatchImmediatelyBeforeWrite": true,
      "maxAutomaticRetries": 1,
      "firstConflictStatus": "STALE_BASE_RETRY",
      "secondConflictStatus": "ABORTED_CONCURRENT_UPDATE",
      "commitStaleAttemptSeparately": false
    },
    "allowedWritePrefixes": [
      "stock/items/",
      "stock/images/",
      "stock/image-runs/"
    ],
    "forbiddenDuringImageRunPrefixes": [
      "stock/_system/",
      "stock/runs/"
    ]
  },
  "concurrency": {
    "requireBaseShaMatchImmediatelyBeforeWrite": true,
    "maxAutomaticRetries": 1,
    "firstConflictStatus": "STALE_BASE_RETRY",
    "secondConflictStatus": "ABORTED_CONCURRENT_UPDATE",
    "commitStaleAttemptSeparately": false
  },
  "transaction": {
    "oneRunOneCommit": true,
    "oneRunOneRefUpdate": true,
    "forceRefUpdate": false,
    "method": [
      "blob",
      "tree",
      "commit",
      "ref-update"
    ]
  },
  "allowedWritePrefixes": [
    "stock/"
  ],
  "forbiddenWritePrefixes": [
    "strains/",
    "sources/",
    "entities/",
    "runtime/",
    "schemas/",
    "scripts/",
    ".github/workflows/",
    "images/"
  ],
  "forbiddenWritePaths": [
    "data.js",
    "sources.js"
  ],
  "protectedBranches": [
    "main"
  ],
  "duplicatePolicy": {
    "checkProduction": true,
    "checkExistingStock": true,
    "strainKeys": [
      "id",
      "canonicalName"
    ],
    "sourceKeys": [
      "id",
      "url"
    ],
    "entityKeys": [
      "id",
      "canonicalName"
    ],
    "conflictingSameIdStatus": "NEEDS_REVIEW",
    "automaticOverwriteOnConflict": false
  },
  "confidence": {
    "allowed": [
      "A",
      "B",
      "C",
      "unknown"
    ],
    "claimFields": [
      "lineage",
      "history",
      "aroma",
      "terpene"
    ]
  },
  "successAudit": {
    "requireMasterHeadChanged": true,
    "requireAllChangedFilesUnderStock": true,
    "requireMainHeadUnchanged": true,
    "requireProtectedTreesUnchanged": true
  }
}
