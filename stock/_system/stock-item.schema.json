{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cannabis-strains-wisdom.local/schemas/auto-stock-v1/stock-item.schema.json",
  "title": "AUTO STOCK V1 / IMAGE STOCK V1 Stock Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stockId",
    "status",
    "createdAt",
    "candidate",
    "confidence",
    "sources",
    "entities",
    "duplicateCheck",
    "visualStatus",
    "visualPreparation",
    "visuals"
  ],
  "properties": {
    "schemaVersion": { "const": "AUTO_STOCK_V1" },
    "stockId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["IMAGE_PENDING", "READY", "NEEDS_REVIEW", "REJECTED_DUPLICATE"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalName", "strainData"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "canonicalName": { "type": "string", "minLength": 1 },
        "strainData": {
          "type": "object",
          "required": ["visuals"],
          "properties": {
            "visuals": {
              "type": "array",
              "items": { "$ref": "#/$defs/visual" }
            }
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage", "history", "aroma", "terpene"],
      "properties": {
        "lineage": { "$ref": "#/$defs/confidenceEntry" },
        "history": { "$ref": "#/$defs/confidenceEntry" },
        "aroma": { "$ref": "#/$defs/confidenceEntry" },
        "terpene": { "$ref": "#/$defs/confidenceEntry" }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceCandidate" },
      "uniqueItems": true
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityCandidate" },
      "uniqueItems": true
    },
    "duplicateCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionChecked", "stockChecked", "strain", "sources", "entities"],
      "properties": {
        "productionChecked": { "const": true },
        "stockChecked": { "const": true },
        "strain": { "$ref": "#/$defs/duplicateResult" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/duplicateResult" } },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/duplicateResult" } }
      }
    },
    "visualStatus": { "enum": ["IMAGE_PENDING", "READY"] },
    "visualPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "evidence", "alt", "rights", "scope", "aiGenerated"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "sourceIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          }
        },
        "alt": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "aiGenerated": { "const": true }
      }
    },
    "visuals": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual" }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "IMAGE_PENDING" } }, "required": ["status"] },
      "then": {
        "properties": {
          "visualStatus": { "const": "IMAGE_PENDING" },
          "visuals": { "maxItems": 0 },
          "candidate": {
            "properties": {
              "strainData": {
                "properties": {
                  "visuals": { "maxItems": 0 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "READY" } }, "required": ["status"] },
      "then": {
        "properties": {
          "visualStatus": { "const": "READY" },
          "visuals": { "minItems": 1, "maxItems": 1 },
          "candidate": {
            "properties": {
              "strainData": {
                "properties": {
                  "visuals": { "minItems": 1, "maxItems": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "visualStatus": { "const": "READY" } }, "required": ["visualStatus"] },
      "then": { "properties": { "status": { "const": "READY" } } }
    }
  ],
  "$defs": {
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "src", "aiGenerated", "sourceType", "rights", "alt", "scope"],
      "properties": {
        "role": { "const": "primary" },
        "src": { "type": "string", "pattern": "^stock/images/[a-z0-9]+(?:-[a-z0-9]+)*/primary\\.webp$" },
        "aiGenerated": { "const": true },
        "sourceType": { "type": "string", "minLength": 1 },
        "rights": { "type": "string" },
        "alt": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["cultivar", "phenotype", "product", "lot"] }
      }
    },
    "confidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "basis"],
      "properties": {
        "grade": { "enum": ["A", "B", "C", "unknown"] },
        "basis": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "sourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "payload"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "payload": { "type": "object" }
      }
    },
    "entityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalName", "payload"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "canonicalName": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      }
    },
    "duplicateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "result"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "result": { "enum": ["UNIQUE", "MATCH", "CONFLICT", "NOT_APPLICABLE"] },
        "matchedPath": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
