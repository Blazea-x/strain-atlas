{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cannabis-strain-wisdom.local/schemas/source.schema.json",
  "title":"Cannabis Strain Wisdom Source",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","id","publisher","title","url","sourceType","supports","checkedAt","note"],
  "properties":{
    "schemaVersion":{"type":"integer","const":1},
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "publisher":{"type":"string","minLength":1},
    "title":{"type":"string","minLength":1},
    "url":{"type":"string","format":"uri"},
    "sourceType":{"type":"string","minLength":1},
    "supports":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "publishedAt":{"type":["string","null"],"format":"date"},
    "checkedAt":{"type":"string","format":"date"},
    "note":{"type":"string"}
  }
}
