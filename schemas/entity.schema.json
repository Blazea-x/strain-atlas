{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cannabis-strain-wisdom.local/schemas/entity.schema.json",
  "title":"Cannabis Strain Wisdom Entity",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","id","name","roles","checkedAt","updatedAt","note"],
  "properties":{
    "schemaVersion":{"type":"integer","const":1},
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name":{"type":"string","minLength":1},
    "roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["originator","breeder","seedCompany","producer","brand","distributor"]}},
    "checkedAt":{"type":"string","format":"date"},
    "updatedAt":{"type":"string","format":"date"},
    "note":{"type":"string"}
  }
}
