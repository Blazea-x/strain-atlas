{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cannabis-strain-wisdom.local/schemas/cultivar.schema.json",
  "title": "Cannabis Strain Wisdom Cultivar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","status","name","jp","aliases","classification","breeding","lineage","relations","aromas","visuals","checkedAt","updatedAt"],
  "properties": {
    "schemaVersion": {"type":"integer","const":1},
    "id": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum":["draft","review","approved","published"]},
    "name": {"type":"string","minLength":1},
    "jp": {"type":["string","null"],"minLength":1},
    "aliases": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "classification": {
      "type":"object","additionalProperties":false,"required":["type"],
      "properties":{"type":{"enum":["sativa","indica","hybrid","sativa-dominant-hybrid","indica-dominant-hybrid","balanced-hybrid","unknown"]}}
    },
    "breeding": {
      "type":"object","additionalProperties":false,"required":["generation"],
      "properties":{"generation":{"enum":["S1","F1","F2","BX1","IBL","unknown","other"]},"method":{"type":["string","null"]}}
    },
    "lineage": {"$ref":"#/$defs/lineageClaim"},
    "relations": {"type":"array","items":{"$ref":"#/$defs/relation"}},
    "aromas": {"$ref":"#/$defs/listClaim"},
    "terpenes": {"$ref":"#/$defs/listClaim"},
    "history": {"$ref":"#/$defs/textClaim"},
    "origin": {"$ref":"#/$defs/textClaim"},
    "visuals": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/visual"}},
    "checkedAt": {"type":"string","format":"date"},
    "updatedAt": {"type":"string","format":"date"}
  },
  "$defs": {
    "evidence": {
      "type":"object","additionalProperties":false,"required":["status"],
      "properties": {
        "status":{"enum":["confirmed","disputed","unknown"]},
        "confidence":{"enum":["A","B","C"]},
        "basis":{"enum":["registered","breederOfficial","seedCompanyOfficial","scientificPublication","specialistDatabase","historicalSource"]},
        "sourceRefs":{"type":"array","items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"uniqueItems":true}
      },
      "allOf":[
        {"if":{"properties":{"status":{"enum":["confirmed","disputed"]}}},"then":{"required":["confidence","basis","sourceRefs"],"properties":{"sourceRefs":{"minItems":1}}}}
      ]
    },
    "lineageClaim": {
      "allOf":[{"$ref":"#/$defs/evidence"}],
      "type":"object","required":["status","display","parents","note"],
      "properties":{"status":{},"confidence":{},"basis":{},"sourceRefs":{},"display":{"type":"string"},"parents":{"type":"array","items":{"type":"string"}},"note":{"type":"string"}}
    },
    "listClaim": {
      "allOf":[{"$ref":"#/$defs/evidence"}],
      "type":"object","required":["status","items","note"],
      "properties":{"status":{},"confidence":{},"basis":{},"sourceRefs":{},"items":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"note":{"type":"string"}}
    },
    "textClaim": {
      "allOf":[{"$ref":"#/$defs/evidence"}],
      "type":"object","required":["status","text","note"],
      "properties":{"status":{},"confidence":{},"basis":{},"sourceRefs":{},"text":{"type":"string"},"note":{"type":"string"}}
    },
    "relation": {
      "type":"object","additionalProperties":false,"required":["entityId","roles","status"],
      "properties":{"entityId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["originator","breeder","seedCompany","producer","brand","distributor"]}},"status":{"enum":["confirmed","disputed","unknown"]},"confidence":{"enum":["A","B","C"]},"basis":{"enum":["registered","breederOfficial","seedCompanyOfficial","scientificPublication","specialistDatabase","historicalSource"]},"sourceRefs":{"type":"array","items":{"type":"string"},"uniqueItems":true}}
    },
    "visual": {
      "type":"object","additionalProperties":false,"required":["role","src","aiGenerated","sourceType","rights","alt","scope"],
      "properties":{"role":{"type":"string","minLength":1},"src":{"type":"string","minLength":1},"aiGenerated":{"type":"boolean"},"sourceType":{"type":"string","minLength":1},"rights":{"type":"string"},"alt":{"type":"string","minLength":1},"scope":{"enum":["cultivar","phenotype","product","lot"]}}
    }
  }
}
