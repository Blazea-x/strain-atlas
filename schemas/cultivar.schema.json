{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cannabis-strain-wisdom.local/schemas/cultivar.schema.json",
  "title": "Cannabis Strain Wisdom Cultivar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","status","name","jp","aliases","classification","breeding","lineage","relations","aromas","visuals","checkedAt","updatedAt"],
  "properties": {
    "schemaVersion": {"type":"integer","const":1},
    "id": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum":["draft","review","approved","published"]},
    "name": {"type":"string","minLength":1},
    "jp": {"type":["string","null"]},
    "aliases": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "classification": {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"enum":["sativa","indica","hybrid","sativa-dominant-hybrid","indica-dominant-hybrid","balanced-hybrid","unknown"]}}},
    "breeding": {"type":"object","additionalProperties":false,"required":["generation"],"properties":{"generation":{"type":"string","pattern":"^(?:S1|F[1-9][0-9]*|BX[1-9][0-9]*|IBL|unknown|other)$"},"method":{"type":["string","null"]}}},
    "lineage": {"$ref":"#/$defs/lineageClaim"},
    "relations": {"type":"array","items":{"$ref":"#/$defs/relation"}},
    "aromas": {"$ref":"#/$defs/listClaim"},
    "terpenes": {"$ref":"#/$defs/listClaim"},
    "history": {"$ref":"#/$defs/textClaim"},
    "origin": {"$ref":"#/$defs/textClaim"},
    "publicContent": {"$ref":"#/$defs/publicContent"},
    "visuals": {"type":"array","items":{"$ref":"#/$defs/visual"}},
    "checkedAt": {"type":"string","format":"date"},
    "updatedAt": {"type":"string","format":"date"}
  },
  "$defs": {
    "status": {"enum":["confirmed","disputed","unknown"]},
    "confidence": {"enum":["A","B","C"]},
    "basis": {"enum":["registered","breederOfficial","seedCompanyOfficial","scientificPublication","specialistDatabase","historicalSource"]},
    "sourceRefs": {"type":"array","items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"uniqueItems":true},
    "lineageClaim": {
      "type":"object","additionalProperties":false,"required":["status","display","parents","note"],
      "properties":{"status":{"$ref":"#/$defs/status"},"confidence":{"$ref":"#/$defs/confidence"},"basis":{"$ref":"#/$defs/basis"},"sourceRefs":{"$ref":"#/$defs/sourceRefs"},"display":{"type":"string"},"parents":{"type":"array","items":{"type":"string"}},"note":{"type":"string"}},
      "allOf":[{"if":{"properties":{"status":{"enum":["confirmed","disputed"]}}},"then":{"required":["confidence","basis","sourceRefs"],"properties":{"sourceRefs":{"minItems":1}}}}]
    },
    "listClaim": {
      "type":"object","additionalProperties":false,"required":["status","items","note"],
      "properties":{"status":{"$ref":"#/$defs/status"},"confidence":{"$ref":"#/$defs/confidence"},"basis":{"$ref":"#/$defs/basis"},"sourceRefs":{"$ref":"#/$defs/sourceRefs"},"items":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"note":{"type":"string"}},
      "allOf":[{"if":{"properties":{"status":{"enum":["confirmed","disputed"]}}},"then":{"required":["confidence","basis","sourceRefs"],"properties":{"sourceRefs":{"minItems":1}}}}]
    },
    "textClaim": {
      "type":"object","additionalProperties":false,"required":["status","text","note"],
      "properties":{"status":{"$ref":"#/$defs/status"},"confidence":{"$ref":"#/$defs/confidence"},"basis":{"$ref":"#/$defs/basis"},"sourceRefs":{"$ref":"#/$defs/sourceRefs"},"text":{"type":"string"},"note":{"type":"string"}},
      "allOf":[{"if":{"properties":{"status":{"enum":["confirmed","disputed"]}}},"then":{"required":["confidence","basis","sourceRefs"],"properties":{"sourceRefs":{"minItems":1}}}}]
    },
    "relation": {
      "type":"object","additionalProperties":false,"required":["entityId","roles","status"],
      "properties":{"entityId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["originator","breeder","seedCompany","producer","brand","distributor"]}},"status":{"$ref":"#/$defs/status"},"confidence":{"$ref":"#/$defs/confidence"},"basis":{"$ref":"#/$defs/basis"},"sourceRefs":{"$ref":"#/$defs/sourceRefs"}},
      "allOf":[{"if":{"properties":{"status":{"enum":["confirmed","disputed"]}}},"then":{"required":["confidence","basis","sourceRefs"],"properties":{"sourceRefs":{"minItems":1}}}}]
    },
    "publicContent": {
      "type":"object","additionalProperties":false,"required":["ja"],
      "properties":{"ja":{"$ref":"#/$defs/publicContentJa"}}
    },
    "publicContentJa": {
      "type":"object","additionalProperties":false,"minProperties":1,
      "properties":{"origin":{"type":"string","minLength":1},"lineageNote":{"type":"string","minLength":1},"history":{"type":"string","minLength":1}}
    },
    "visual": {
      "type":"object","additionalProperties":false,"required":["role","src","aiGenerated","sourceType","rights","alt","scope"],
      "properties":{"role":{"type":"string","minLength":1},"src":{"type":"string","minLength":1},"aiGenerated":{"type":"boolean"},"sourceType":{"type":"string","minLength":1},"rights":{"type":"string"},"alt":{"type":"string","minLength":1},"scope":{"enum":["cultivar","phenotype","product","lot"]}}
    }
  }
}
